# ==============================================================================
# Zero-Trust Autonomous Machine Customer — Environment Configuration
# ==============================================================================

# Application Port & Node Environment
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Open Policy Agent (OPA) — External Authorization PDP
# ------------------------------------------------------------------------------
# In production, OPA runs as a dedicated daemon or sidecar container.
# If OPA_SERVER_URL is unset in dev, the client uses an embedded in-memory AST evaluator.
OPA_SERVER_URL=http://localhost:8181/v1/data/machine_customer/authz

# When true, rejects requests fail-closed if the external OPA daemon is unreachable.
# Default: true in production, false in development (enables safe local fallback).
OPA_ENFORCE_STRICT=false

# ------------------------------------------------------------------------------
# Settlement Rails & Payment Gateway
# ------------------------------------------------------------------------------
# Settlement rail execution mode: "http" for external settlement gateway, "mock" for local sandbox
SETTLEMENT_RAIL_MODE=mock
SETTLEMENT_RAIL_URL=https://api.settlement.internal
SETTLEMENT_API_KEY=mock-settlement-key-for-dev

# ------------------------------------------------------------------------------
# Spend Ledger Store (Durable Persistence)
# ------------------------------------------------------------------------------
# For file-backed persistence: stored automatically in .data/spend_ledger.json
# For production PostgreSQL persistence:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/machine_customer

# ------------------------------------------------------------------------------
# Zero-Trust Network & Identity Mesh
# ------------------------------------------------------------------------------
# OpenZiti client identity configuration file path
ZITI_IDENTITY_FILE=./ziti-identity.json

# SPIFFE / SPIRE Workload API Unix Domain Socket
SPIFFE_ENDPOINT_SOCKET=unix:///tmp/spire-agent/public/api.sock
